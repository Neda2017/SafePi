{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    
    "outDir": "dist",
    "rootDir": "src",

    "types": ["node", "express", "cors"]
  },
  "include": ["src/**/*"]
}
