{
  "name": "Safeπ - Pi Network Security",
  "short_name": "Safeπ",
  "description": "Real-time scam detection and phishing protection for Pi Network users. Protect your Pi assets from phishing, fake wallets, and fraudulent sites.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0c1222",
  "theme_color": "#0369a1",
  "orientation": "any",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-72.png",
      "sizes": "72x72",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Scan URL",
      "short_name": "Scan",
      "description": "Quickly scan a URL for threats",
      "url": "/?action=scan",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Check Wallet",
      "short_name": "Wallet",
      "description": "Check wallet address",
      "url": "/?action=wallet",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "categories": ["security", "utilities", "productivity"],
  "screenshots": [
    {
      "src": "/screenshot-mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ],
  "share_target": {
    "action": "/scan",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+safepi",
      "url": "/scan?url=%s"
    }
  ]
}
